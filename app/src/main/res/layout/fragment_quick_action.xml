<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvQuickActionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Actions"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1F2937" />

    <LinearLayout
        android:id="@+id/quickActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- 1. Home Collection -->
        <LinearLayout
            android:id="@+id/actionHomeCollection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:oriesntation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
             >

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#0F8A5F"
                    android:contentDescription="Home Collection" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Home\nCollection"
                android:textAlignment="center"
                android:textSize="11sp"
                android:textColor="#1F2937" />
        </LinearLayout>

        <!-- 2. Book Test -->
        <LinearLayout
            android:id="@+id/actionBookTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
             >

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_bookings"
                    app:tint="#0F8A5F"
                    android:contentDescription="Book Test" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Book\nTest"
                android:textAlignment="center"
                android:textSize="11sp"
                android:textColor="#1F2937" />
        </LinearLayout>

        <!-- 3. My Bookings -->
        <LinearLayout
            android:id="@+id/actionMyBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
            >

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_bookings"
                    app:tint="#0F8A5F"
                    android:contentDescription="My Bookings" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="My\nBookings"
                android:textAlignment="center"
                android:textSize="11sp"
                android:textColor="#1F2937" />
        </LinearLayout>

        <!-- 4. Reports -->
        <LinearLayout
            android:id="@+id/actionReports"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
            >

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_reports"
                    app:tint="#0F8A5F"
                    android:contentDescription="Reports" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="\nReports"
                android:textAlignment="center"
                android:textSize="11sp"
                android:textColor="#1F2937" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>